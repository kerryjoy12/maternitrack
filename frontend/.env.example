# ---------------------------------------------------------------------------
# MaterniTrack — React frontend (.env.example)
# Copy to `frontend/.env` and fill in the real values to run the app.
# ---------------------------------------------------------------------------

# Base URL for the Django backend REST API
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Supabase project (if you use Supabase authentication / messaging)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
